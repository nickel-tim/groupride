// This is what the wrangler.jsonc in the project root should look like once the league goes live.
// Guide: liga/DEPLOY.md. The folders "liga" and "api" are in .assetsignore and are
// not served as a web page.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "groupride",
  "compatibility_date": "2026-01-01",
  "main": "api/index.js",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Static files come directly from Cloudflare, the worker only runs for the API.
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "groupride",
      "database_id": "HIER-DIE-ID-AUS-wrangler-d1-create",
      "migrations_dir": "liga/migrations"
    }
  ],

  // Sender of the login e-mails; the domain must be verified at Resend.
  // Secrets (AUTH_SECRET, RESEND_API_KEY) NOT here, but: npx wrangler secret put <NAME>
  "vars": { "MAIL_FROM": "Gruppenausfahrt <login@example.com>" }
}
