{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "groupride",
  "compatibility_date": "2026-01-01",
  "main": "api/index.js",

  // Der Repo-Stamm ist das Asset-Verzeichnis; .assetsignore haelt Relay, Tests, Server-Code und Doku heraus.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Statische Dateien kommen direkt von Cloudflare, der Worker laeuft nur fuer die API.
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "groupride",
      "database_id": "7926bf9b-723e-450d-b933-bc90127a8ad4",
      "migrations_dir": "liga/migrations"
    }
  ],

  // Absender der Anmelde-Mails; die Domain muss bei Resend verifiziert sein.
  // Geheimnisse (AUTH_SECRET, RESEND_API_KEY) stehen NICHT hier, sondern per: npx wrangler secret put <NAME>
  "vars": { "MAIL_FROM": "Groupride <login@nickeltim.de>" }
}
