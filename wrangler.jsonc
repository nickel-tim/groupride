{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "groupride",
  "compatibility_date": "2026-01-01",
  "main": "api/index.js",

  // The repo root is the asset directory; .assetsignore keeps the relay, tests, server code and docs out.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Static files come directly from Cloudflare, the worker only runs for the API.
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "groupride",
      "database_id": "7926bf9b-723e-450d-b933-bc90127a8ad4",
      "migrations_dir": "liga/migrations"
    }
  ],

  // Sender of the login e-mails; the domain must be verified at Resend.
  // Secrets (AUTH_SECRET, RESEND_API_KEY) are NOT stored here, but via: npx wrangler secret put <NAME>
  "vars": { "MAIL_FROM": "Groupride <login@nickeltim.de>" }
}
